# Copy this file to .env and fill in real values
# Never commit .env to source control

# MongoDB configuration
MONGO_URI=mongodb://localhost:27017/project_health
MONGO_DATABASE=project_health

# Auth / JWT
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_A_STRONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# GitHub API personal access token
GITHUB_TOKEN=your_github_personal_access_token

# CORS — comma-separated list of allowed frontend origins
# Example: CORS_ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# LLM API
OPENROUTER_API_KEY=